# The toolchain this firmware is built with, outside this repository. CI reads this file, and it is
# the record of what the local build tree should match. See "Continuous integration and releases"
# in firmware/CLAUDE.md before changing anything here.

# ESP-IDF release, which is also the tag of the espressif/idf container image the workflow runs in.
# The lwIP fix in patches/lwip/ is applied on top of it.
IDF_VERSION=v5.5.4

# esp-matter: a commit on tomasmcguinness/esp-matter, patched with patches/esp-matter/.
ESP_MATTER_REPO=https://github.com/tomasmcguinness/esp-matter.git
ESP_MATTER_COMMIT=c21bea27fbef29428e9610673502de775077c031

# connectedhomeip, checked out inside esp-matter. This is newer than the commit c21bea27 records
# (efefc94f), on purpose: it is what the local build uses.
CHIP_REPO=https://github.com/project-chip/connectedhomeip.git
CHIP_COMMIT=c992539e738378e6e9a13c2f8cd47b1c878d069b
