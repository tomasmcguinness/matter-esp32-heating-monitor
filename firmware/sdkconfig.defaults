# Waveshare ESP32-S3-ETH: 16MB flash, octal PSRAM.
# (These were previously set by hand through menuconfig and only lived in sdkconfig.)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

#enable BT
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# Use a custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Testing Options
CONFIG_USE_TEST_SETUP_PIN_CODE=20212020
CONFIG_USE_TEST_SETUP_DISCRIMINATOR=0xF0

# Enable chip shell
CONFIG_ENABLE_CHIP_SHELL=y
CONFIG_ESP_MATTER_CONSOLE_TASK_STACK=4096

# lwip
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=12

# Increase Stack size
CONFIG_CHIP_TASK_STACK_SIZE=15360
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# Increase udp endpoints num for commissioner
CONFIG_NUM_UDP_ENDPOINTS=16

# Enable Controller and commissioner
CONFIG_ENABLE_CHIP_CONTROLLER_BUILD=y
CONFIG_ESP_MATTER_CONTROLLER_ENABLE=y
CONFIG_ESP_MATTER_COMMISSIONER_ENABLE=y

# Enable HKDF in mbedtls
CONFIG_MBEDTLS_HKDF_C=y

# Increase LwIP IPv6 address number to 6 (MAX_FABRIC + 1)
# unique local addresses for fabrics(MAX_FABRIC), a link local address(1)
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# Enable project configurations
CONFIG_CHIP_PROJECT_CONFIG="main/matter_project_config.h"

# Increase console buffer length
CONFIG_CHIP_SHELL_CMD_LINE_BUF_MAX_LENGTH=512

# Console over the devkit's USB serial/JTAG port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# WebSocket support in the HTTP server (used by /ws) and room for the SPA's headers
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=512

# Allocate Matter's buffers from PSRAM
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y


# Disable WiFi network commissioning driver
CONFIG_WIFI_NETWORK_COMMISSIONING_DRIVER=n

# Ethernet (W5500 over SPI) is the only host transport on this board
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_ENABLE_ETHERNET_TELEMETRY=y

# We are a controller, not a commissionable device: no Network Commissioning cluster
CONFIG_ETHERNET_NETWORK_COMMISSIONING_DRIVER=n

# Custom CHIP platform layer (external_platform/ESP32_custom), which replaces the
# internal-EMAC ESPEthernetDriver::Init() with a W5500 one. The root CMakeLists.txt
# syncs the in-repo copy to $ESP_MATTER_PATH/../platform/ESP32_custom, which is what
# these GN-relative paths resolve to.
CONFIG_CHIP_ENABLE_EXTERNAL_PLATFORM=y
CONFIG_CHIP_EXTERNAL_PLATFORM_DIR="../../../../../platform/ESP32_custom"
CONFIG_CHIP_EXTERNAL_PLATFORM_INCLUDE_DIR="../../../../.."

# No WiFi on this board. BLE stays enabled: it is still used to commission the
# Thread temperature sensors (pairing_ble_thread).
CONFIG_ENABLE_WIFI_STATION=n
CONFIG_ENABLE_WIFI_TELEMETRY=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# CHIP's minimal mDNS, rather than the ESP-IDF mdns component.
#
# The IDF component cannot express a subtype query: it splits a service name on the first
# dot only (mdns_querier.c) and then writes each part as a single DNS label
# (append_string(), mdns_send.c), so CHIP's "_S<disc>._sub._matterc" goes out as
# _S3 | _sub._matterc | _udp | local instead of _S3 | _sub | _matterc | _udp | local.
# Nothing matches the malformed label, so commissionable-node discovery gets no answer and
# times out after 30s. Operational discovery is unaffected — it passes instance/type/proto
# separately with no subtype, which is why subscriptions work while commissioning does not.
#
# Cost: minimal mDNS owns UDP 5353, so start_mdns_service() in app_main.cpp is disabled and
# heating-monitor.local / _http._tcp are no longer published. Reach the web UI by IP.
CONFIG_USE_MINIMAL_MDNS=y
